# =====================================================
# SAGE — Backend Environment Configuration
# =====================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/sage
# For production: MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/sage

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# LLM Configuration (choose one)
# Option 1: OpenRouter (recommended for variety of models)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=mistralai/mistral-7b-instruct

# Option 2: OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Option 3: Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Active LLM Provider (openrouter | openai | ollama)
LLM_PROVIDER=openrouter

# HuggingFace (for embeddings)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Embedding Model
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Vector Store (faiss | chroma)
VECTOR_STORE=faiss
CHROMA_URL=http://localhost:8000

# File Upload
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
