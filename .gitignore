# =====================================================
# SAGE AI — Root Git Ignore Rules
# =====================================================

# Dependency Directories
node_modules/
jspm_packages/
web_modules/

# Build and Production outputs
dist/
build/
out/
.next/
coverage/

# Logs and Debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment / Secret Files
.env
.env.*
!.env.example

# Temporary / OS / IDE Files
.DS_Store
Thumbs.db
desktop.ini
*.bak
*.tmp
*.temp
*.swp
.idea/
.vscode/settings.json
*.iml
.cache/

# Local Uploads and Databases
uploads/
backend/uploads/*
!backend/uploads/.gitkeep
